# VWorld API (필수)
# https://www.vworld.kr → 오픈API → 인증키 발급
# 활용API: WMS/WFS, 검색, 2D데이터 (필요 시 국가중점)
VWORLD_API_KEY=
# 발급키는 비워 둔다
VWORLD_DOMAIN=http://localhost

# Carto Basemaps (단순지도 · Voyager)
# https://carto.com → API Keys
CARTO_API_KEY=
# 발급키는 비워 둔다

# Copernicus Data Space (지형 DEM · 월간 sync)
# 발급: https://dataspace.copernicus.eu 로그인
#   우측 상단 프로필 → Sentinel Hub
#   왼쪽 User Settings → OAuth clients → Create
# Client ID / Client Secret 을 아래에 넣는다 (Secret은 창을 닫으면 다시 못 봄)
# 30m(GLO-30)는 Identity Portal > Personal Info 에서
#   "I am also interested in accessing Copernicus Contributing Missions data" 체크 후
#   CDSE_DEM_INSTANCE=COPERNICUS_30
CDSE_CLIENT_ID=
# 발급값은 비워 둔다
CDSE_CLIENT_SECRET=
# 발급값은 비워 둔다
CDSE_DEM_INSTANCE=COPERNICUS_90

# 서버
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenAI 호환 Chat Completions (텍스트·이미지 공용 VLM)
# 키는 서버만 읽고 브라우저에 노출하지 않음
# 게이트웨이 카탈로그 id는 LLM42-Gemma4 (표시명 Gemma-4-31B-Vision)
CLOVA_API_KEY=
# 발급키는 비워 둔다
CLOVA_BASE_URL=https://api.clovastudio.go.kr/api/v1
CLOVA_MODEL=LLM42-Gemma4
# 사내 게이트웨이 자체서명 체인. true면 공인 CA만 허용
CLOVA_SSL_VERIFY=false

# DB
DATABASE_PATH=data/sitedia_seocho.sqlite

# 서울열린데이터광장 (가로수 위치)
# https://data.seoul.go.kr → 인증키 발급
SEOUL_OPEN_API_KEY=
# 발급키는 비워 둔다

# 관리 API (실데이터 동기화, fixture 재적재)
# 비어 있으면 /api/admin 은 거부. 화면에는 적지 않고 요청 헤더 X-Admin-Token 으로만 보낸다.
ADMIN_TOKEN=
# 발급값은 비워 둔다
